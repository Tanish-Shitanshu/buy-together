# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox). Leave empty to run with simulated holds.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
# Seconds the Undo window stays open before money moves.
UNDO_SECONDS=8
# Languages and voice: Sarvam. Leave empty for offline mode with scripted text.
SARVAM_API_KEY=
# Other model providers are optional and only used when no Sarvam key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Optional real price check
CHANNEL3_API_KEY=
PORT=8787
